#!/usr/bin/env bash
# post-merge — clean up the worktree of a branch that was just merged.
#
# Safety contract: this hook NEVER deletes a worktree that has uncommitted
# changes, and never deletes the main checkout. When anything is unclear it
# warns and does nothing. A cleanup tool that deletes on its own is a tool you
# stop trusting.
#
# Installed via: git config core.hooksPath .githooks

set -uo pipefail   # deliberately no -e: a merge must never fail because of cleanup

log() { printf '[post-merge] %s\n' "$*"; }

# Only act on the main checkout, never from inside a worktree.
git_common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || exit 0
git_dir="$(git rev-parse --path-format=absolute --git-dir 2>/dev/null)" || exit 0
[[ "${git_common}" == "${git_dir}" ]] || exit 0

main_root="$(dirname "${git_common}")"
current_branch="$(git -C "${main_root}" branch --show-current 2>/dev/null)" || exit 0

# Only clean up after merging into an integration branch.
case "${current_branch}" in
    main|master|develop) ;;
    *) exit 0 ;;
esac

# Which branches are now fully merged into the current one? Those are the
# candidates — a branch still holding unmerged commits is never touched.
merged_raw="$(git -C "${main_root}" branch --merged HEAD --format='%(refname:short)' 2>/dev/null)" || exit 0
mapfile -t merged < <(printf '%s\n' "${merged_raw}" | grep -vxE 'main|master|develop' || true)
[[ ${#merged[@]} -gt 0 ]] || exit 0

# Map worktree path -> branch, from the authoritative porcelain listing.
declare -A wt_branch=()
wt_path=""
porcelain="$(git -C "${main_root}" worktree list --porcelain 2>/dev/null)" || exit 0
while IFS= read -r line; do
    case "${line}" in
        worktree\ *) wt_path="${line#worktree }" ;;
        branch\ *)
            [[ -n "${wt_path}" ]] && wt_branch["${wt_path}"]="${line#branch refs/heads/}"
            ;;
        '') wt_path="" ;;
        *) ;;   # ignore HEAD/bare/detached/locked lines
    esac
done < <(printf '%s\n' "${porcelain}")

for branch in "${merged[@]}"; do
    for path in "${!wt_branch[@]}"; do
        [[ "${wt_branch[${path}]}" == "${branch}" ]] || continue
        [[ "${path}" == "${main_root}" ]] && continue          # never the main checkout
        [[ -d "${path}" ]] || continue

        # Refuse on ANY local state: tracked modifications or untracked files.
        dirty="$(git -C "${path}" status --porcelain 2>/dev/null)" || true
        if [[ -n "${dirty}" ]]; then
            log "WARNING: '${branch}' is merged but its worktree has uncommitted changes."
            log "         Not removing: ${path}"
            continue
        fi

        # Refuse if the worktree is mid-operation (rebase in progress).
        if git -C "${path}" rev-parse --verify -q REBASE_HEAD >/dev/null 2>&1; then
            log "WARNING: '${branch}' worktree is mid-rebase, not removing: ${path}"
            continue
        fi

        if git -C "${main_root}" worktree remove "${path}" 2>/dev/null; then
            log "removed worktree for merged branch '${branch}': ${path}"
        else
            log "WARNING: could not remove worktree for '${branch}': ${path}"
        fi
    done
done

# pwt prune is a read-only reporter and exits 1 when it finds stale entries.
# Surface its report, never let its exit status escape.
if command -v pwt >/dev/null 2>&1; then
    pwt prune 2>/dev/null || true
fi

exit 0
